<?xml version="1.0" encoding="utf-8"?>
<!-- Arabic translation. Draft by Claude; please have a native speaker review before release. -->
<!-- The session alert (ringing, Settings > Alert sound) and the Lockdown blocking screen. -->
<resources>

    <!-- Notification button that stops the ringing alert. -->
    <string name="alert_stop">إيقاف</string>

    <!-- Lockdown blocking screen, shown over other apps until the user returns to the session. "Adhkaar" = the daily remembrances of Allah (transliterated Arabic); "dhikr" = one of them. -->
    <string name="block_title_morning">أذكار الصباح في انتظارك</string>
    <string name="block_title_evening">أذكار المساء في انتظارك</string>
    <string name="block_body">التطبيقات الأخرى متوقفة الآن. دقائق هادئة مع الله، ثم تعود إليك.</string>
    <!-- %1$d = adhkaar not yet finished in this session. -->
    <plurals name="block_remaining">
        <item quantity="zero">بقي %1$d ذكر</item>
        <item quantity="one">بقي ذكر واحد</item>
        <item quantity="two">بقي ذكران</item>
        <item quantity="few">بقيت %1$d أذكار</item>
        <item quantity="many">بقي %1$d ذكرًا</item>
        <item quantity="other">بقي %1$d ذكر</item>
    </plurals>
    <string name="block_start">ابدأ أذكارك</string>
    <string name="block_return">عُد إلى أذكارك</string>
    <string name="block_call">اتصال أو طوارئ</string>

    <!-- Settings > Reminders > Alert sound. -->
    <string name="settings_alert_sound">صوت التنبيه</string>
    <!-- %1$d = minutes until the second ring (10). -->
    <plurals name="settings_alert_sound_hint">
        <item quantity="zero">يرنّ دقيقة في وقت الجلسة، ومرة أخرى بعد %1$d دقيقة إن لم تُفتح</item>
        <item quantity="one">يرنّ دقيقة في وقت الجلسة، ومرة أخرى بعد دقيقة إن لم تُفتح</item>
        <item quantity="two">يرنّ دقيقة في وقت الجلسة، ومرة أخرى بعد دقيقتين إن لم تُفتح</item>
        <item quantity="few">يرنّ دقيقة في وقت الجلسة، ومرة أخرى بعد %1$d دقائق إن لم تُفتح</item>
        <item quantity="many">يرنّ دقيقة في وقت الجلسة، ومرة أخرى بعد %1$d دقيقة إن لم تُفتح</item>
        <item quantity="other">يرنّ دقيقة في وقت الجلسة، ومرة أخرى بعد %1$d دقيقة إن لم تُفتح</item>
    </plurals>
    <!-- The two choices: the app’s own bell sound, or the user’s recorded voice. -->
    <string name="settings_alert_chime">النغمة</string>
    <string name="settings_alert_recording">تسجيلي</string>
    <string name="settings_alert_chime_title">نغمة الأذكار</string>
    <string name="settings_alert_chime_text">جرس هادئ متصاعد، صُنع لهذا التطبيق</string>
    <string name="settings_alert_your_recording">تنبيهك</string>
    <string name="settings_alert_repeats">يتكرر مع وقفات قصيرة أثناء الرنين</string>
    <string name="settings_alert_record_prompt">سجّل تنبيهك بصوتك</string>
    <string name="settings_alert_record_example">قل مثلًا: «حان وقت أذكار الصباح». وإلى أن تسجّل، تُشغَّل النغمة.</string>
</resources>
