<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-only by design (docs/design/DESIGN.md). The window matches the aura's base so launch has no flash. -->
    <style name="Theme.Adhkaar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- A card over the lock screen: the window is see-through, the card draws its own dim. -->
    <style name="Theme.Adhkaar.Card" parent="Theme.Adhkaar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
