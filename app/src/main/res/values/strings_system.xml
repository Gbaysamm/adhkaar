<?xml version="1.0" encoding="utf-8"?>
<!-- Strings used outside the Compose UI: notifications, calendar reminders, Hijri calendar, Lockdown overlay. -->
<resources>

    <!-- Notification channels (shown in the system notification settings) -->
    <string name="channel_session_name">Adhkaar time</string>
    <string name="channel_session_description">Opens your morning and evening adhkaar at the time you chose</string>
    <string name="channel_gentle_name">Reminders</string>
    <string name="channel_gentle_description">Heads-up before a session, Friday and fasting-day reminders</string>

    <!-- Session notifications. "Adhkaar" = the daily remembrances of Allah (transliterated Arabic). -->
    <string name="notif_title_morning">Morning adhkaar</string>
    <string name="notif_title_evening">Evening adhkaar</string>
    <string name="notif_session_text_morning">It\'s time for your morning adhkaar. Tap to begin.</string>
    <string name="notif_session_text_evening">It\'s time for your evening adhkaar. Tap to begin.</string>
    <!-- Notification action button. %1$d = number of minutes the session is postponed. -->
    <!-- Heads-up before a session. %1$s = session title ("Morning adhkaar" / "Evening adhkaar"), %2$d = minutes until it starts. -->
    <plurals name="notif_pre_reminder_title">
        <item quantity="one">%1$s in %2$d minute</item>
        <item quantity="other">%1$s in %2$d minutes</item>
    </plurals>
    <string name="notif_pre_reminder_text">A moment to finish what you’re doing.</string>

    <!-- Collection reminders. "Salah" = the ritual prayer; "dhikr" = remembrance of Allah. -->
    <string name="reminder_after_salah_title">After salah</string>
    <string name="reminder_after_salah_text">A few moments of dhikr to seal your prayer.</string>
    <string name="reminder_before_sleep_title">Before sleep</string>
    <string name="reminder_before_sleep_text">End your day with the adhkaar of the night.</string>

    <!-- Calendar reminders. %1$s = the event title, e.g. "The Day of Arafah". -->
    <string name="reminder_eve_title">Tomorrow: %1$s</string>
    <!-- Friday greeting. "Jumuʿah" = Friday (the congregational prayer day), transliterated; keep the ʿ. ﷺ = salla Allahu alayhi wa sallam, keep as is. -->
    <string name="reminder_friday_title">Jumuʿah Mubarak</string>
    <string name="reminder_friday_body">Read Surah al-Kahf today, and send abundant salawat on the Prophet ﷺ.</string>

    <!-- Special days of the Islamic calendar. Titles are mostly transliterated Arabic names; hadith/Qur'an references are kept in code and not translated. ﷺ = salla Allahu alayhi wa sallam, keep as is. -->
    <!-- "Jumuʿah" = Friday, transliterated; keep the ʿ. -->
    <string name="event_jumuah_title">Jumuʿah</string>
    <string name="event_jumuah_body">Read Surah al-Kahf and send abundant salawat on the Prophet ﷺ.</string>
    <string name="event_last_ten_nights_title">The last ten nights</string>
    <!-- Contains a transliterated Arabic duʿa (Allāhumma innaka ʿafuwwun…); keep the transliteration as is. -->
    <string name="event_last_ten_nights_body">Seek Laylat al-Qadr. Say: Allāhumma innaka ʿafuwwun tuḥibbul-ʿafwa faʿfu ʿannī.</string>
    <string name="event_ramadan_title">Ramadan</string>
    <string name="event_ramadan_body">The month of the Qur’an. Increase your recitation and your duʿa.</string>
    <string name="event_eid_al_fitr_title">Eid al-Fitr</string>
    <string name="event_eid_al_fitr_body">Eid Mubarak. Say the takbir, and give zakat al-fitr before the prayer if you haven’t.</string>
    <string name="event_dhul_hijjah_ten_title">The best ten days</string>
    <!-- Contains transliterated Arabic phrases (lā ilāha illallāh…); keep them as is. -->
    <string name="event_dhul_hijjah_ten_body">Increase tahlil, takbir and tahmid: lā ilāha illallāh, Allāhu akbar, al-ḥamdu lillāh.</string>
    <string name="event_arafah_title">The Day of Arafah</string>
    <string name="event_arafah_body">Fasting today expiates the sins of the past year and the coming year.</string>
    <string name="event_eid_al_adha_title">Eid al-Adha</string>
    <string name="event_eid_al_adha_body">Eid Mubarak. Remember Allah with takbir through the days of tashriq.</string>
    <!-- "Tasuʿa" = the 9th of Muharram, transliterated; keep the ʿ. -->
    <string name="event_tasua_title">Tasuʿa</string>
    <string name="event_tasua_body">Fast today with Ashura tomorrow, as the Prophet ﷺ intended.</string>
    <!-- "Ashura" = the 10th of Muharram, transliterated. -->
    <string name="event_ashura_title">Ashura</string>
    <string name="event_ashura_body">Fasting today expiates the sins of the past year.</string>
    <!-- The 13th, 14th and 15th of each Hijri month. -->
    <string name="event_white_days_title">The white days</string>
    <string name="event_white_days_body">Fasting the 13th, 14th and 15th of the month is sunnah.</string>

    <!-- Hijri (Islamic lunar) month names, transliterated from Arabic. Use the customary spelling for your language. -->
    <string name="hijri_month_muharram">Muharram</string>
    <string name="hijri_month_safar">Safar</string>
    <string name="hijri_month_rabi_al_awwal">Rabiʿ al-Awwal</string>
    <string name="hijri_month_rabi_al_thani">Rabiʿ al-Thani</string>
    <string name="hijri_month_jumada_al_ula">Jumada al-Ula</string>
    <string name="hijri_month_jumada_al_akhirah">Jumada al-Akhirah</string>
    <string name="hijri_month_rajab">Rajab</string>
    <string name="hijri_month_shaban">Shaʿban</string>
    <string name="hijri_month_ramadan">Ramadan</string>
    <string name="hijri_month_shawwal">Shawwal</string>
    <string name="hijri_month_dhu_al_qadah">Dhu al-Qaʿdah</string>
    <string name="hijri_month_dhu_al_hijjah">Dhu al-Hijjah</string>
    <!-- Hijri date, e.g. "14 Rabiʿ al-Thani 1448". %1$d = day of month, %2$s = month name, %3$d = Hijri year. -->
    <string name="hijri_month_date_format">%1$d %2$s %3$d</string>

    <!-- Lockdown overlay, drawn over other apps until the session is completed. -->
</resources>
