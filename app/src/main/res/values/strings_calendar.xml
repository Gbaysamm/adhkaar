<?xml version="1.0" encoding="utf-8"?>
<!-- The dual Hijri/Gregorian calendar (Today and Insights) and the streak sheet on Today. -->
<resources>
    <!-- Calendar header switch: which calendar leads (large numbers, grid by its months). Keep short. -->
    <string name="calendar_hijri">Hijri</string>
    <string name="calendar_gregorian">Gregorian</string>
    <!-- Calendar header, the Gregorian months a Hijri month runs across. %1$s = first month, %2$s = last month, %3$d = year, e.g. "September – October 2026". -->
    <string name="calendar_gregorian_span">%1$s – %2$s %3$d</string>
    <!-- As calendar_gregorian_span across a new year. %1$s %2$d = first month and year, %3$s %4$d = last month and year. -->
    <string name="calendar_gregorian_span_years">%1$s %2$d – %3$s %4$d</string>
    <!-- A day in two calendars, the leading one first. %1$s = e.g. "14 Rabiʿ al-Thani 1448", %2$s = e.g. "Saturday, 26 September". -->
    <string name="calendar_day_dates">%1$s · %2$s</string>
    <!-- Screen reader label for the arrow that reopens the chosen day's reminder. -->
    <string name="calendar_open_reminder">Open this day\'s reminder</string>
    <!-- Weekday names above the calendar, Sunday first, as on Nigerian Islamic calendars: transliterated Arabic, kept as is in every language except Arabic (which uses the Arabic names). -->
    <string-array name="calendar_weekdays_arabic">
        <item>Ahd</item>
        <item>Ith</item>
        <item>Thul</item>
        <item>Arb</item>
        <item>Kha</item>
        <item>Jum</item>
        <item>Sabt</item>
    </string-array>

    <!-- Streak sheet title (opened from the flame pill on Today). -->
    <string name="streak_title">Your streak</string>
    <!-- Screen reader label for the flame pill on Today, which opens the streak sheet. -->
    <string name="streak_open_cd">Streak details</string>
    <!-- Distance to the next streak milestone. %1$d = days left (chooses the plural form), %2$d = the milestone, e.g. "3 days to a 7-day streak". -->
    <plurals name="streak_to_milestone">
        <item quantity="one">%1$d day to a %2$d-day streak</item>
        <item quantity="other">%1$d days to a %2$d-day streak</item>
    </plurals>
    <!-- Streak sheet encouragement, warm and never preachy. No streak yet. -->
    <string name="streak_line_start">Every streak begins with a single day. Today can be that day.</string>
    <!-- The streak runs to yesterday; today's sessions are not done yet. -->
    <string name="streak_line_waiting">Today\'s adhkaar will carry your streak forward.</string>
    <!-- Today is done and this is the longest streak so far. -->
    <string name="streak_line_best">Your longest streak yet. Keep it gently, one day at a time.</string>
    <!-- Today is done. -->
    <string name="streak_line_done">Today is counted. May Allah accept it from you.</string>
    <string name="streak_close">Close</string>
</resources>
