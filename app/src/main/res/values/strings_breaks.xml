<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Breaks: a busy user pauses an alarm-started morning/evening session for a while.
         Nothing rings or blocks until the break ends; then the session rings again. The adhkaar
         must still be done before the session's window ("Ends after" in Settings) closes. ===== -->
    <!-- The quiet pill under the counter that opens the break choices -->
    <string name="break_take">Take a break</string>
    <!-- Title of the break dialog -->
    <string name="break_title">Need a moment?</string>
    <!-- In the break dialog: what a break does -->
    <string name="break_rings_again">Your phone is free until the break ends. Then the alert rings again.</string>
    <!-- In the break dialog when every break would end after the window closes -->
    <string name="break_no_time">Not enough time left for a break</string>
    <!-- Under the break pill and in the dialog. %1$s = time the window closes, e.g. "7:30 PM" -->
    <string name="break_done_by">Must be done by %1$s</string>
    <!-- A break choice. %1$d = minutes (10, 20 or 30) -->
    <plurals name="break_option_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <!-- A break choice. %1$d = hours (1) -->
    <plurals name="break_option_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <!-- Session notification during a break. %1$s = when the break ends, %2$s = when the window closes, e.g. "5:20 PM" -->
    <string name="break_notification">On a break until %1$s · must be done by %2$s</string>
    <!-- Shown by the system back button while Lockdown keeps the session on screen -->
    <string name="session_lockdown_toast">Complete your adhkaar, or take a break</string>
    <plurals name="break_left">
        <item quantity="one">%1$d adhkaar left</item>
        <item quantity="other">%1$d adhkaar left</item>
    </plurals>
    <string name="break_back_at">Back at %1$s. Then the alert rings again.</string>
    <string name="break_keep_reading">Keep reading</string>
    <string name="break_pick_time">Choose a time</string>
    <string name="break_pause_for">Pause for %1$s</string>
    <string name="break_unit_min">min</string>
    <string name="break_unit_hour">hour</string>
    <string name="break_confirm_title">Before you pause</string>
    <plurals name="break_confirm_left">
        <item quantity="one">Just %1$d dhikr left. A few minutes, and today\'s adhkaar are done.</item>
        <item quantity="other">Just %1$d adhkaar left. A few minutes, and today\'s adhkaar are done.</item>
    </plurals>
    <plurals name="break_confirm_streak">
        <item quantity="one">You have kept them for %1$d day in a row.</item>
        <item quantity="other">You have kept them for %1$d days in a row. Don\'t let today be the gap.</item>
    </plurals>
    <string name="break_confirm_hadith">The one who remembers his Lord and the one who does not are like the living and the dead.</string>
    <string name="break_confirm_source">Sahih al-Bukhari 6407</string>
    <string name="break_confirm_stay">Stay and finish</string>
    <string name="session_end_test">Test · End test</string>
    <string name="break_confirm_hold">Hold to pause for %1$s</string>
</resources>
