    <!-- Permission requirements -->
    <string name="req_notifications">Notifications</string>
    <string name="req_notifications_why">So the app can alert you at adhkaar time.</string>
    <string name="req_exact_alarms">Alarms &amp; reminders</string>
    <string name="req_exact_alarms_why">Starts your session at the exact minute, even when the phone is asleep.</string>
    <string name="req_full_screen">Full-screen alerts</string>
    <string name="req_full_screen_why">Opens the adhkaar over the lock screen, like an alarm clock.</string>
    <string name="req_overlay">Display over other apps</string>
    <string name="req_overlay_why">Opens the adhkaar while you’re using another app, and pauses other apps in Lockdown. If a list opens, tap Adhkaar and allow it.</string>
    <string name="req_usage_access">Usage access</string>
    <string name="req_usage_access_why">Lets Lockdown see which app is open. Nothing is recorded or leaves your phone. In the list, tap Adhkaar and turn it on.</string>
    <string name="req_battery">Unrestricted battery</string>
    <string name="req_battery_why">Stops Android from putting the app to sleep and missing your adhkaar time.</string>

