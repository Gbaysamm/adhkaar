<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The reminder of the day (a verse, hadith or fact) and the day card image. -->
    <!-- The sheet's title: %1$s = Gregorian date (reminder_gregorian_date), %2$s = Hijri date, e.g. "Saturday 26 September 2026 · 14 Rabiʿ al-Thani 1448". -->
    <string name="reminder_date_both">%1$s · %2$s</string>
    <!-- %1$s = weekday, %2$d = day, %3$s = month, %4$d = year, e.g. "Saturday 26 September 2026". -->
    <string name="reminder_gregorian_date">%1$s %2$d %3$s %4$d</string>
    <!-- Small label above the reminder, shown in capitals. -->
    <string name="reminder_kind_verse">From the Qur\'an</string>
    <string name="reminder_kind_hadith">From the Sunnah</string>
    <string name="reminder_kind_fact">About this day</string>
    <!-- Button: save the day card to the phone's gallery. -->
    <string name="reminder_save_image">Save image</string>
    <!-- Toast after saving. "Pictures/Adhkaar" is the folder name on the phone; keep it as is. -->
    <string name="reminder_saved">Saved to Pictures/Adhkaar</string>
    <string name="reminder_save_failed">Couldn\'t save the image</string>
    <!-- Title of the system share sheet. -->
    <string name="reminder_share_chooser">Share reminder</string>
    <!-- Screen reader description of the small card preview. -->
    <string name="reminder_image_preview">Preview of the image to share</string>

    <!-- Day card (the shareable image). On the hanging tag: %1$s = short weekday, e.g. "Today is Sat.". -->
    <string name="day_card_today_is">Today is %1$s.</string>
    <!-- Under the big day number: %1$s = short Hijri month (day_card_month_short), %2$s = Hijri year, e.g. "R/Thani 1448". -->
    <string name="day_card_tag_month">%1$s %2$s</string>
    <!-- The Hijri year under the month title, in gold. %1$s = year, e.g. "1448AH". -->
    <string name="day_card_year_ah">%1$sAH</string>
    <!-- Both dates in one line. %1$s = short weekday, %2$s = Hijri day (e.g. "14th"), %3$s = Hijri month, %4$s = Hijri year,
         %5$s = Gregorian day (e.g. "26th"), %6$s = short Gregorian month, %7$s = Gregorian year.
         e.g. "Sat. 14th of Rabiʿ al-Thani 1448 › 26th of Sep, 2026". -->
    <string name="day_card_pill">%1$s. %2$s of %3$s %4$s  ›  %5$s of %6$s, %7$s</string>
    <!-- Short Hijri month names for the small tag, Muharram first. -->
    <string-array name="day_card_month_short">
        <item>Muharram</item>
        <item>Safar</item>
        <item>R/Awwal</item>
        <item>R/Thani</item>
        <item>J/Ula</item>
        <item>J/Akhirah</item>
        <item>Rajab</item>
        <item>Shaʿban</item>
        <item>Ramadan</item>
        <item>Shawwal</item>
        <item>Dhul-Qaʿdah</item>
        <item>Dhul-Hijjah</item>
    </string-array>
    <!-- The Arabic day names, shortened, Sunday first (al-Ahad … as-Sabt). The row under them shows the local names. -->
    <string-array name="day_card_weekdays">
        <item>Ahd</item>
        <item>Ith</item>
        <item>Thul</item>
        <item>Arb</item>
        <item>Kha</item>
        <item>Jum</item>
        <item>Sabt</item>
    </string-array>
    <!-- Whether to show the local weekday names under the Arabic ones; off where they would repeat them (Arabic). -->
    <bool name="day_card_show_local_weekdays">true</bool>
    <!-- A day that may or may not be in this Hijri month, until the moon sighting is announced. -->
    <string name="day_card_unknown_day" translatable="false">?</string>
</resources>
