    <string name="session_done">Done</string>
    <!-- Accessibility labels for the heart button -->
    <string name="session_favourite_add">Add to favourites</string>
    <string name="session_favourite_remove">Remove from favourites</string>

    <!-- ===== Counter ===== -->
    <!-- How many times a dhikr is said, e.g. "×3". %1$d = repetitions -->
    <plurals name="counter_times">
        <item quantity="one">×%1$d</item>
        <item quantity="other">×%1$d</item>
    </plurals>
    <!-- Under the big count in the counter orb, e.g. "of 33". %1$d = target count -->
    <string name="counter_of_target">of %1$d</string>
    <!-- Accessibility label for the check mark shown when the count is complete -->
    <string name="counter_done">Done</string>

    <!-- ===== Completion screen ===== -->
    <string name="completion_morning_headline">Your day begins\nin His care</string>
    <string name="completion_evening_headline">Your night rests\nin His care</string>
    <!-- Hadith about the dhikr "Bismillahil-ladhi la yadurru…" (Abu Dawud 5088), morning wording -->
    <string name="completion_morning_quote">Whoever says it three times in the morning will not be struck by sudden affliction until the evening.</string>
    <!-- Same hadith, evening wording -->
    <string name="completion_evening_quote">Whoever says it three times in the evening will not be struck by sudden affliction until the morning.</string>
    <!-- Source line under the hadith: opening words of the dhikr (transliterated) and the hadith reference -->
    <string name="completion_reference">Bismillāhil-ladhī lā yaḍurru… · Abu Dawud 5088</string>
    <!-- Wraps the hadith text in quotation marks. %1$s = the quote -->
    <string name="completion_quote_format">“%1$s”</string>
    <!-- Headline when a collection has no completion text of its own. %1$s = collection name -->
    <string name="completion_collection_headline">%1$s\ncomplete</string>
    <!-- Stat label under the number of adhkaar said -->
    <plurals name="completion_stat_adhkaar">
        <item quantity="one">Adhkaar</item>
        <item quantity="other">Adhkaar</item>
    </plurals>
    <!-- Stat label under the time taken -->
    <string name="completion_stat_time">Time</string>
    <!-- Time taken, shown as a stat. %1$d = minutes -->
    <string name="completion_minutes">%1$d min</string>
    <!-- Stat label under the streak length (in days) -->
    <plurals name="completion_day_streak">
        <item quantity="one">Day streak</item>
        <item quantity="other">Day streak</item>
    </plurals>
    <!-- Stat label under how many times a collection has been completed today -->
    <plurals name="completion_times_today">
        <item quantity="one">Time today</item>
        <item quantity="other">Times today</item>
    </plurals>
    <string name="completion_done">Done</string>

