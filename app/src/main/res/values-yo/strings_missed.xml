    <string name="missed_title_yesterday">Adhkaar ìrọ̀lẹ́ àná kọjá</string>
    <string name="missed_body">Ó máa ń ṣẹlẹ̀ sí gbogbo wa. Ohun tó ṣe pàtàkì ni ìgbà tó ń bọ̀, gbogbo ìgbésẹ̀ kékeré sì níye lórí.</string>
