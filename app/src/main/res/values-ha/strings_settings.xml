    <!-- Permission requirements -->
    <string name="req_notifications">Sanarwa</string>
    <string name="req_notifications_why">Don manhajar ta tunatar da kai lokacin azkar da sallah.</string>
    <string name="req_exact_alarms">Ƙararrawa &amp; tunatarwa</string>
    <string name="req_exact_alarms_why">Yana fara azkar a daidai minti, ko da waya na barci. Kamar agogon ƙararrawa.</string>
    <string name="req_full_screen">Sanarwar cikakken allo</string>
    <string name="req_full_screen_why">Yana nuna azkar a kan allon kulle idan lokacinsu ya yi, kamar agogon ƙararrawa.</string>
    <string name="req_overlay">Nunawa a kan sauran manhajoji</string>
    <string name="req_overlay_why">Yana nuna azkar ko tunatarwar sallah yayin da kake wata manhaja, kuma yana rufe sauran a Kulle. Adhkaar ba ya ganin abin da ke kan allonka.</string>
    <string name="req_usage_access">Damar ganin amfani</string>
    <string name="req_usage_access_why">Yana ba Kulle damar sanin wace manhaja ke buɗe, don ya rufe sauran kawai, ba kiranka ba. Sunayen manhajoji kawai yake gani, ba abin da ke cikinsu ba, kuma ba ya ajiye komai.</string>
    <string name="req_battery">Batir ba tare da taƙaitawa ba</string>
    <string name="req_battery_why">Yana hana Android sa Adhkaar barci, don kada azkar su wuce. Yana amfani da batir kaɗan ƙwarai.</string>

