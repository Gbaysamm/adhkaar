    <!-- Permission requirements -->
    <string name="req_notifications">Ọkwa</string>
    <string name="req_notifications_why">Ka ngwa ahụ chetara gị n\'oge adhkaar na salah.</string>
    <string name="req_exact_alarms">Mkpu &amp; ncheta</string>
    <string name="req_exact_alarms_why">Ọ na-amalite adhkaar gị n\'otu nkeji ahụ, ọbụna mgbe ekwentị na-ehi ụra. Dị ka elekere mkpu.</string>
    <string name="req_full_screen">Ọkwa ihuenyo niile</string>
    <string name="req_full_screen_why">Ọ na-egosi adhkaar n\'elu ihuenyo mkpọchi mgbe oge ha ruru, dị ka elekere mkpu.</string>
    <string name="req_overlay">Gosi n\'elu ngwa ndị ọzọ</string>
    <string name="req_overlay_why">Ọ na-ewepụta adhkaar ma ọ bụ ncheta salah mgbe ị nọ na ngwa ọzọ, ọ na-ekpuchikwa ndị ọzọ na Mkpọchi. Adhkaar enweghị ike ịhụ ihe dị n\'ihuenyo gị.</string>
    <string name="req_usage_access">Ohere ojiji ngwa</string>
    <string name="req_usage_access_why">Ọ na-eme ka Mkpọchi mara ngwa mepere emepe, ka ọ kpuchie naanị ndị ọzọ, ọ bụghị oku gị. Ọ na-ahụ naanị aha ngwa, ọ bụghị ihe dị n\'ime ha, ọ dịghịkwa ihe ọ na-edebe.</string>
    <string name="req_battery">Batrị na-enweghị mmachi</string>
    <string name="req_battery_why">Ọ na-egbochi Android ime ka Adhkaar hie ụra, ka adhkaar ghara ịgafe. Ọ na-eji obere batrị.</string>

