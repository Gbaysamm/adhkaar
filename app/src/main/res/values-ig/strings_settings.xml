    <string name="setup_title">Nhazi ekwentị</string>
    <string name="setup_intro">Android na-akwụsị ngwa n\'azụ iji chekwaa batrị, ya mere adhkaar chọrọ ikike ole na ole iji bịa n\'oge. Nke ọ bụla na-ekwu ihe ọ bụ maka ya. Ọ dịghị nke na-enye Adhkaar ohere ịhụ ozi gị, foto, kọntaktị ma ọ bụ ihe onwe gị ọ bụla, ọ dịghịkwa ihe na-apụ na ekwentị gị.</string>
    <string name="setup_all_set">Ihe niile adịla njikere</string>
    <!-- Progress: %1$d = steps done, %2$d = total steps. -->
    <plurals name="setup_ready_count">
        <item quantity="other">%1$d n\'ime %2$d adịla njikere</item>
    </plurals>
    <!-- %1$s = phone brand(s), e.g. "Samsung" or "Xiaomi / Redmi / POCO" -->
