    <string name="today_section_today">Taa</string>

    <!-- %1$d = number of consecutive days. -->
    <plurals name="today_streak_days">
        <item quantity="other">Ụbọchị %1$d n\'usoro</item>
    </plurals>
    <string name="today_start_streak">Malite usoro gị taa</string>
    <!-- %1$d = days with adhkaar done, %2$d = total days in the period (30). -->
    <plurals name="today_days_of_total">
        <item quantity="other">%1$d n\'ime ụbọchị %2$d</item>
    </plurals>

    <!-- Chart legend and session tile names. -->
    <string name="today_morning">Ụtụtụ</string>
    <string name="today_evening">Mgbede</string>
