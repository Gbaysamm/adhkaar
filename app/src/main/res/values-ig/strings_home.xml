<?xml version="1.0" encoding="utf-8"?>
<!-- Igbo translation. DRAFT by Claude: must be reviewed by a native Igbo speaker before release. -->
<resources>
    <!-- Shared formatting -->
    <!-- Countdown when the target time has arrived (lowercase, used inline). -->
    <string name="format_now">ugbu a</string>
    <!-- Compact countdown. %1$d = hours, %2$d = minutes. "awa" = hour, "nk" = nkeji (minute). -->
    <string name="format_hours_minutes">%1$d awa %2$d nk</string>
    <!-- Compact countdown under an hour. %1$d = minutes. -->
    <string name="format_minutes">%1$d nk</string>
    <!-- Full date. %1$s = weekday name, %2$d = day of month, %3$s = month name. -->
    <string name="format_gregorian_date">%1$s, %2$d %3$s</string>

    <!-- Prayer names -->
    <string name="prayer_fajr">Fajr</string>
    <!-- Sunrise time shown alongside the prayer times (not a prayer itself). -->
    <string name="prayer_sunrise">Ọwụwa anyanwụ</string>
    <string name="prayer_dhuhr">Dhuhr</string>
    <string name="prayer_asr">Asr</string>
    <string name="prayer_maghrib">Maghrib</string>
    <string name="prayer_isha">Isha</string>

    <!-- Today screen -->
    <!-- Greeting. %1$s = time-of-day word (today_greeting_morning etc.), shown in italics. Igbo: "Ụtụtụ ọma". -->
    <string name="today_greeting">%1$s ọma</string>
    <string name="today_greeting_morning">Ụtụtụ</string>
    <string name="today_greeting_afternoon">Ehihie</string>
    <string name="today_greeting_evening">Mgbede</string>

    <string name="today_section_prayer_times">Ncheta salah</string>
    <string name="today_section_this_week">Izu a</string>
    <string name="today_section_last_30_days">Ụbọchị 30 gara aga</string>
