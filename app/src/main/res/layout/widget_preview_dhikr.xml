<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+) of the Dhikr of the moment widget, in the Glass style. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:tint="#FFF2CF8A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_name_dhikr"
            android:textAllCaps="true"
            android:textColor="#7AFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/amiri_quran"
        android:gravity="center"
        android:text="@string/widget_preview_dhikr_arabic"
        android:textColor="#FFF5F7FF"
        android:textDirection="rtl"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/widget_preview_dhikr_meaning"
        android:textColor="#B8FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
